<Window x:Class="Bookworm.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Bookworm Setup" Height="380" Width="480"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=VaEmailBox}">
    <StackPanel Margin="24">
        <TextBlock Text="Welcome to Bookworm" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#555">
            Sign in with your own Vision Australia Library account. This is the only thing you need to
            enter — everything else is already set up.
        </TextBlock>

        <Label Content="Vision Australia email or member number" Target="{Binding ElementName=VaEmailBox}"/>
        <TextBox x:Name="VaEmailBox" AutomationProperties.Name="Vision Australia email or member number"
                 FontSize="16" Padding="4" Margin="0,0,0,12"/>

        <Label Content="Password" Target="{Binding ElementName=VaPasswordBox}"/>
        <PasswordBox x:Name="VaPasswordBox" AutomationProperties.Name="Vision Australia password"
                     FontSize="16" Padding="4" Margin="0,0,0,12"/>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10"
                   AutomationProperties.LiveSetting="Assertive"/>

        <Button x:Name="SignInButton" Content="Sign In" Height="48" FontSize="16"
                Click="SignInButton_Click"/>
    </StackPanel>
</Window>
